  },
  "validate-novel-gem.yml": {
    "concurrency": null,
    "jobs": {
      "validate_novel_gem": {
        "name": "Attempt generic MSYS2 build (windows-ucrt64)",
        "runs-on": "windows-latest",
        "needs": [],
